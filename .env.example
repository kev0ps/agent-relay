# Example values to set in the environment; never source one file indiscriminately
# for both the server and agent. Do not commit real files.

# Shared by both processes; public configuration value.
AGENT_RELAY_DEVICE_ID=linux-dev-1

# Server only: the two values must be distinct and random.
AGENT_RELAY_AGENT_TOKEN=[GENERATE_A_PRIVATE_AGENT_TOKEN]
AGENT_RELAY_CONTROL_TOKEN=[GENERATE_A_PRIVATE_CONTROL_TOKEN]
AGENT_RELAY_HOST=127.0.0.1
AGENT_RELAY_PORT=8000
AGENT_RELAY_MAX_WS_MESSAGE_BYTES=131072
# Remote deployment only: use 0.0.0.0 only with a firewall/TLS plan,
# explicit opt-in, and a non-empty MCP Host allowlist.
# AGENT_RELAY_ALLOW_NON_LOOPBACK_BIND=true
# AGENT_RELAY_MCP_ALLOWED_HOSTS=relay.example.test:*
# AGENT_RELAY_MCP_ALLOWED_ORIGINS=https://relay.example.test

# Agent only: prefer the 0600 file to AGENT_RELAY_AGENT_TOKEN.
AGENT_RELAY_SERVER_URL=ws://127.0.0.1:8000/ws/agent
AGENT_RELAY_WORKSPACE=/absolute/path/to/workspace
AGENT_RELAY_AGENT_TOKEN_FILE=/absolute/path/to/agent.token
# AGENT_RELAY_AGENT_TOKEN=[NOT_RECOMMENDED_USE_TOKEN_FILE]
# Optional agent settings:
# AGENT_RELAY_HEARTBEAT_INTERVAL_SECONDS=15
# AGENT_RELAY_RECONNECT_MIN_SECONDS=0.1
# AGENT_RELAY_RECONNECT_MAX_SECONDS=5
# AGENT_RELAY_STABLE_SESSION_SECONDS=30
# AGENT_RELAY_MAX_WS_MESSAGE_BYTES=131072
# AGENT_RELAY_COMMAND_TIMEOUT_SECONDS=30
# AGENT_RELAY_STDOUT_LIMIT=24576
# AGENT_RELAY_STDERR_LIMIT=24576
# Optional Browser capability (requires the browser extra and external Chromium):
# AGENT_RELAY_BROWSER_CDP_URL=http://127.0.0.1:9222
# AGENT_RELAY_BROWSER_ALLOWED_ORIGINS=http://127.0.0.1:8899
# AGENT_RELAY_BROWSER_CONNECT_TIMEOUT_SECONDS=5
# AGENT_RELAY_BROWSER_ACTION_TIMEOUT_SECONDS=10
# Optional Computer Use capability (requires the computer extra on Linux x86_64).
# All three identity settings are required together and match exactly. The driver
# must be an absolute existing non-symlink executable. Permission-prompt titles
# are rejected. cua-driver 0.8.3 exposes actionable nodes but no enabled state;
# accepted elements are therefore reported as enabled=true.
# AGENT_RELAY_COMPUTER_DRIVER_PATH=/absolute/path/to/cua-driver
# AGENT_RELAY_COMPUTER_ALLOWED_APP_NAME=Fixture
# AGENT_RELAY_COMPUTER_ALLOWED_WINDOW_TITLE=Relay Desktop Fixture
# AGENT_RELAY_COMPUTER_STARTUP_TIMEOUT_SECONDS=5
# AGENT_RELAY_COMPUTER_ACTION_TIMEOUT_SECONDS=10
# AGENT_RELAY_COMPUTER_SHUTDOWN_TIMEOUT_SECONDS=3
# AGENT_RELAY_COMPUTER_MAX_ELEMENTS=300
