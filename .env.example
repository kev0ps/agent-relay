# Canonical Agent Relay MVP environment overrides.
# Normal installations should use `agent-relay config init` and the shared YAML
# file at ~/.agent-relay/config.yaml. This file is for Docker/automation only;
# Server and Agent are separate processes, so do not source it indiscriminately.
# Keep real credentials private and never commit them. Canonical RELAY_* variables
# override YAML values when both are present; legacy AGENT_RELAY_* variables are
# not supported.

# Relay Server only. The current implementation has one listener on
# RELAY_SERVER_HOST:RELAY_SERVER_PORT and serves both /mcp and /ws/agent.
RELAY_SERVER_HOST=0.0.0.0
RELAY_SERVER_PORT=8000
RELAY_MCP_TOKEN=[GENERATE_A_PRIVATE_MCP_TOKEN]
RELAY_AGENT_TOKEN=[GENERATE_A_PRIVATE_AGENT_TOKEN]
# Server default: true. The Agent URL policy is documented below.
RELAY_ALLOW_INSECURE_WS=true

# Deferred optional MCP host/origin settings. They are not required by the
# simple one-listener MVP and are intentionally unset by the Docker example.
# RELAY_MCP_ALLOWED_HOSTS=relay.example.test:8000
# RELAY_MCP_ALLOWED_ORIGINS=https://relay.example.test

# Relay Agent only. Prefer the private 0600 token file.
# The URL path is intentionally not fixed by the configuration contract.
RELAY_URL=ws://127.0.0.1:8000/ws/agent
RELAY_AGENT_TOKEN_FILE=/absolute/path/to/agent.token
RELAY_AGENT_WORKSPACE=/absolute/path/to/workspace
# Keep the identity stable across environment-only restarts. config init agent
# generates and persists this UUID in YAML.
RELAY_AGENT_ID=00000000-0000-4000-8000-000000000001
# No Agent tools are enabled unless explicitly selected. Use comma-separated
# public names; relay_device_status is Server-local and cannot be selected.
# RELAY_AGENT_TOOLS=relay_system_ping,relay_terminal_exec

# Agent URL policy: true permits ws:// and wss://; false rejects non-loopback
# ws:// while still accepting wss://. Loopback ws:// remains suitable locally.
# Set true only when a trusted LAN/test deployment intentionally uses plaintext.
# RELAY_ALLOW_INSECURE_WS=true

# Optional Agent settings, using canonical names:
# RELAY_AGENT_HEARTBEAT_INTERVAL_SECONDS=15
# RELAY_AGENT_RECONNECT_MIN_SECONDS=0.1
# RELAY_AGENT_RECONNECT_MAX_SECONDS=5
# RELAY_AGENT_STABLE_SESSION_SECONDS=30
# RELAY_AGENT_MAX_WS_MESSAGE_BYTES=131072
# RELAY_AGENT_COMMAND_TIMEOUT_SECONDS=30
# RELAY_AGENT_STDOUT_LIMIT=24576
# RELAY_AGENT_STDERR_LIMIT=24576
# Optional Browser capability (requires the browser extra). The Agent launches
# Playwright's bundled Chromium with this persistent User Data Dir; it does not
# attach to an external browser or expose CDP. Do not use a User Data Dir that
# is already locked by another Chromium instance.
# RELAY_AGENT_BROWSER_USER_DATA_DIR=/absolute/path/to/chromium-user-data
# The default origin_policy is allowlist. Set it to any to allow every HTTP(S)
# Web origin; omit BROWSER_ALLOWED_ORIGINS in that mode. Non-Web schemes such
# as file://, javascript:, data:, chrome://, and edge:// remain forbidden.
# RELAY_AGENT_BROWSER_ORIGIN_POLICY=allowlist
# RELAY_AGENT_BROWSER_ALLOWED_ORIGINS=http://127.0.0.1:8899
# RELAY_AGENT_BROWSER_HEADLESS=false
# RELAY_AGENT_BROWSER_STARTUP_TIMEOUT_SECONDS=30
# RELAY_AGENT_BROWSER_ACTION_TIMEOUT_SECONDS=10
# Optional Computer Use capability (requires the computer extra on Linux x86_64).
# All three identity settings are required together and match exactly. The driver
# must be an absolute existing non-symlink executable. Permission-prompt titles
# are rejected. cua-driver 0.8.3 exposes actionable nodes but no enabled state;
# accepted elements are therefore reported as enabled=true.
# RELAY_AGENT_COMPUTER_DRIVER_PATH=/absolute/path/to/cua-driver
# RELAY_AGENT_COMPUTER_ALLOWED_APP_NAME=Fixture
# RELAY_AGENT_COMPUTER_ALLOWED_WINDOW_TITLE=Relay Desktop Fixture
# RELAY_AGENT_COMPUTER_STARTUP_TIMEOUT_SECONDS=5
# RELAY_AGENT_COMPUTER_ACTION_TIMEOUT_SECONDS=10
# RELAY_AGENT_COMPUTER_SHUTDOWN_TIMEOUT_SECONDS=3
# RELAY_AGENT_COMPUTER_MAX_ELEMENTS=300
